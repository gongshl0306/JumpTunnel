{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JumpTunnel",
  "version": "0.2.0",
  "identifier": "com.jumptunnel.app",
  "build": {
    "beforeDevCommand": "node C:/Users/gsl15/ZCodeProject/dev-frontend.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node C:/Users/gsl15/ZCodeProject/build-frontend.mjs",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JumpTunnel — SSH 端口转发工具",
        "width": 820,
        "height": 720,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
